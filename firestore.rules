rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all unmatched paths by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidCurrency(code) {
      return code in ['BDT', 'USD', 'EUR', 'GBP', 'INR', 'CAD', 'AUD', 'JPY'];
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.email is string && data.email.size() <= 120 &&
             isValidCurrency(data.currencyCode) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTransaction(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             (data.amount is float || data.amount is int) && data.amount > 0 && data.amount <= 1000000000 &&
             data.type in ['INCOME', 'EXPENSE'] &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             (!('note' in data) || (data.note is string && data.note.size() <= 300)) &&
             data.dateMillis is int && data.dateMillis > 0 &&
             data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$') &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidBudget(data, userId) {
      return data.userId == userId &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             (data.limitAmount is float || data.limitAmount is int) && data.limitAmount > 0 && data.limitAmount <= 1000000000 &&
             data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$') &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidRecurring(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             (data.amount is float || data.amount is int) && data.amount > 0 && data.amount <= 1000000000 &&
             data.type in ['INCOME', 'EXPENSE'] &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.frequency in ['WEEKLY', 'MONTHLY', 'YEARLY'] &&
             data.dayOfMonth is int && data.dayOfMonth >= 1 && data.dayOfMonth <= 31 &&
             data.nextDueMillis is int && data.nextDueMillis > 0 &&
             data.reminderDaysBefore is int && data.reminderDaysBefore >= 0 && data.reminderDaysBefore <= 14 &&
             data.active is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidLoan(data, userId) {
      return data.userId == userId &&
             data.kind in ['BORROW', 'LEND'] &&
             data.personName is string && data.personName.size() >= 1 && data.personName.size() <= 80 &&
             (data.amount is float || data.amount is int) && data.amount > 0 && data.amount <= 1000000000 &&
             (data.paidAmount is float || data.paidAmount is int) && data.paidAmount >= 0 && data.paidAmount <= data.amount &&
             data.dateMillis is int && data.dateMillis > 0 &&
             (!('note' in data) || (data.note is string && data.note.size() <= 300)) &&
             data.settled is bool &&
             data.repayments is list && data.repayments.size() <= 100 &&
             (data.repayments.size() == 0 || data.repayments[0] is string) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId) &&
                       isOwner(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'currencyCode', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'currencyCode', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isValidId(userId) &&
                       isOwner(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'currencyCode', 'updatedAt']);

      allow delete: if isValidId(userId) && isOwner(userId);

      match /transactions/{txId} {
        allow get: if isValidId(userId) && isValidId(txId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);

        allow create: if isValidId(userId) &&
                         isValidId(txId) &&
                         isOwner(userId) &&
                         incoming().keys().hasAll(['userId', 'title', 'amount', 'type', 'category', 'dateMillis', 'monthKey', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'amount', 'type', 'category', 'note', 'dateMillis', 'monthKey', 'createdAt', 'updatedAt']) &&
                         isValidTransaction(incoming(), userId);

        allow update: if isValidId(userId) &&
                         isValidId(txId) &&
                         isOwner(userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTransaction(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'amount', 'type', 'category', 'note', 'dateMillis', 'monthKey', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(txId) && isOwner(userId);
      }

      match /budgets/{budgetId} {
        allow get: if isValidId(userId) && isValidId(budgetId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);

        allow create: if isValidId(userId) &&
                         isValidId(budgetId) &&
                         isOwner(userId) &&
                         incoming().keys().hasAll(['userId', 'category', 'limitAmount', 'monthKey', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'category', 'limitAmount', 'monthKey', 'createdAt', 'updatedAt']) &&
                         isValidBudget(incoming(), userId);

        allow update: if isValidId(userId) &&
                         isValidId(budgetId) &&
                         isOwner(userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidBudget(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['category', 'limitAmount', 'monthKey', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(budgetId) && isOwner(userId);
      }

      match /recurring/{recurringId} {
        allow get: if isValidId(userId) && isValidId(recurringId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);

        allow create: if isValidId(userId) &&
                         isValidId(recurringId) &&
                         isOwner(userId) &&
                         incoming().keys().hasAll(['userId', 'title', 'amount', 'type', 'category', 'frequency', 'dayOfMonth', 'nextDueMillis', 'reminderDaysBefore', 'active', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'amount', 'type', 'category', 'frequency', 'dayOfMonth', 'nextDueMillis', 'reminderDaysBefore', 'active', 'createdAt', 'updatedAt']) &&
                         isValidRecurring(incoming(), userId);

        allow update: if isValidId(userId) &&
                         isValidId(recurringId) &&
                         isOwner(userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidRecurring(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'amount', 'type', 'category', 'frequency', 'dayOfMonth', 'nextDueMillis', 'reminderDaysBefore', 'active', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(recurringId) && isOwner(userId);
      }

      match /loans/{loanId} {
        allow get: if isValidId(userId) && isValidId(loanId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);

        allow create: if isValidId(userId) &&
                         isValidId(loanId) &&
                         isOwner(userId) &&
                         incoming().keys().hasAll(['userId', 'kind', 'personName', 'amount', 'paidAmount', 'dateMillis', 'settled', 'repayments', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'kind', 'personName', 'amount', 'paidAmount', 'dateMillis', 'note', 'settled', 'repayments', 'createdAt', 'updatedAt']) &&
                         isValidLoan(incoming(), userId);

        allow update: if isValidId(userId) &&
                         isValidId(loanId) &&
                         isOwner(userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidLoan(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['kind', 'personName', 'amount', 'paidAmount', 'dateMillis', 'note', 'settled', 'repayments', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(loanId) && isOwner(userId);
      }
    }
  }
}
